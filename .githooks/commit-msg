#!/bin/sh
# Enforces the commit message and branch naming conventions:
#   message: [GEOG-XX] <type>: <Description>
#   branch:  GEOG_XX_YY, where XX matches the task id in the message

message_file="$1"
subject=$(grep -v '^#' "$message_file" | grep -v '^[[:space:]]*$' | head -n 1)

fail() {
    echo "commit-msg: $1" >&2
    echo "  subject: $subject" >&2
    echo "  expected: [GEOG-XX] <feat|fix|refactor|test|infra>: <Description>" >&2
    echo "  (capital letter, imperative mood, no trailing period; branch GEOG_XX_<name>)" >&2
    exit 1
}

# Messages generated by git itself
case "$subject" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

echo "$subject" | grep -Eq '^\[GEOG-[0-9]+\] (feat|fix|refactor|test|infra): [A-Z]' \
    || fail "subject does not follow the convention"

case "$subject" in
    *.) fail "subject must not end with a period" ;;
esac

task_id=$(echo "$subject" | sed -E 's/^\[GEOG-([0-9]+)\].*/\1/')

# Detached HEAD (e.g. during rebase) has no branch to check
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0

case "$branch" in
    master|main) exit 0 ;;
esac

echo "$branch" | grep -Eq '^GEOG_[0-9]+_[a-z0-9_]+$' \
    || fail "branch '$branch' does not follow GEOG_XX_<name> (lowercase name)"

branch_id=$(echo "$branch" | sed -E 's/^GEOG_([0-9]+)_.*/\1/')
[ "$branch_id" = "$task_id" ] \
    || fail "task id GEOG-$task_id does not match branch '$branch' (GEOG-$branch_id)"

exit 0
